# ═══════════════════════════════════════════════════════════════════
# Variables de entorno
#
# Copiá este archivo como `.env.local` para desarrollo. En producción se
# cargan en Netlify: Site configuration → Environment variables.
#
# Ninguna es obligatoria para que el sitio compile y se vea. Lo que hace cada
# una cuando falta está escrito abajo, y en todos los casos es "no hacer nada"
# y no "romper". El sitio publicado sin una sola de estas variables funciona:
# lo que no funciona es la medición ni el guardado de consultas.
#
# Las que empiezan con NEXT_PUBLIC_ se incrustan en el JavaScript que llega al
# navegador. Cualquiera puede leerlas. Nunca poner un secreto ahí.
# ═══════════════════════════════════════════════════════════════════


# ── Dirección del sitio ────────────────────────────────────────────
# De acá salen el canonical, el sitemap y la URL de la imagen que se ve al
# compartir el enlace. Sin dominio propio, Netlify define `URL` sola y no hace
# falta tocar esto. Sin barra al final.
#
# Si falta: se usa la URL de Netlify y, en desarrollo, localhost.
NEXT_PUBLIC_SITE_URL=


# ── Medición ───────────────────────────────────────────────────────
# Los dos proveedores conviven y reciben los mismos eventos. Se puede usar
# uno, los dos o ninguno. Cómo leerlos está en README-MEDICION.md.

# Google Analytics 4. Formato G-XXXXXXXXXX.
# Si falta: no se carga el script de Google y no se le pide un byte.
NEXT_PUBLIC_GA_ID=

# Umami: medición sin cookies, ~2 KB, sin cartel de consentimiento.
# El identificador es un UUID que da el panel al crear el sitio.
# Si falta: no se carga el script de Umami.
NEXT_PUBLIC_UMAMI_ID=

# Sólo si Umami corre en un servidor propio. Vacío apunta al servicio.
NEXT_PUBLIC_UMAMI_HOST=


# ═══════════════════════════════════════════════════════════════════
# LO QUE SIGUE ES SECRETO
#
# Nada de esto lleva NEXT_PUBLIC_ y nada de esto llega al navegador. Lo leen
# únicamente las dos funciones de `netlify/functions/`, que corren en el
# servidor de Netlify.
# ═══════════════════════════════════════════════════════════════════


# ── Supabase: dónde se guardan las consultas ───────────────────────
# El SQL de la tabla está en `supabase/leads.sql`.
# Panel de Supabase → Settings → API.

# La dirección del proyecto: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# La clave `service_role`, NO la `anon`. Saltea las políticas de fila, que es
# justo lo que hace falta acá y lo que la vuelve peligrosa en cualquier otro
# lado. No la pegues nunca en código del cliente.
#
# Si falta (cualquiera de las dos): el formulario no guarda. Si además falta
# Resend, el formulario responde error y le ofrece WhatsApp a la persona, en
# vez de decir "gracias" mientras pierde la consulta.
SUPABASE_SERVICE_ROLE_KEY=

# Sal para la huella de la dirección IP que se usa para limitar a cinco
# envíos por hora. Cualquier cadena larga y al azar sirve; se define una vez y
# no se cambia, porque cambiarla reinicia el conteo.
#
# Si falta: se sigue hasheando, sin sal. El límite funciona igual.
LEADS_IP_SALT=


# ── Resend: el aviso por correo ────────────────────────────────────
# resend.com → API Keys.
#
# Si falta cualquiera de las tres: no se manda el aviso y la consulta se
# guarda igual en Supabase. Es el caso explícitamente contemplado.
RESEND_API_KEY=

# A dónde llega el aviso.
LEADS_EMAIL_TO=visintinstudio@gmail.com

# Desde qué dirección sale. Tiene que ser de un dominio verificado en Resend.
# Mientras no haya dominio propio, Resend permite `onboarding@resend.dev`.
LEADS_EMAIL_FROM=Visintin Studio <onboarding@resend.dev>


# ── Descarga de la lista ───────────────────────────────────────────
# Protege /api/leads/export. Cadena larga y al azar, por ejemplo:
#   openssl rand -hex 32
#
# Si falta: la descarga responde 503 y no expone nada.
ADMIN_TOKEN=
