# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ...menos el ejemplo, que no tiene ni un secreto y es el único lugar donde
# está escrito qué hace cada variable y qué pasa si falta. Sin esta
# línea, `.env*` lo tapa y el archivo no se commitea nunca.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Netlify
.netlify/

# Capturas crudas de los sitios del portfolio. Son intermedias: lo que se
# publica son los AVIF/WebP de public/imagenes/, generados a partir de estas.
.capturas/

# Capturas de revisión del propio sitio (herramientas/capturar-pagina.mjs).
.revision/

# Capturas crudas de "antes" (busquedas, fichas, paginas caidas). Lo que se
# publica son los AVIF/WebP de public/imagenes/evidencia/, generados con
# herramientas/procesar-evidencia.mjs. Las crudas traen datos personales.
.evidencia/
